rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && member().role == 'parent' && request.resource.data.family == member().family && request.resource.data.role == 'student' && code.matches('[0-9]{8}') && request.resource.data.keys().hasOnly(['name','family','role']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 32;
      allow update: if request.auth != null && !('claimed' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']) && request.resource.data.claimed == request.auth.uid && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == code;
    }
    match /members/{uid} {
      function invite() { return getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data; }
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','family','role','code']) && invite().claimed == uid && invite().role == request.resource.data.role && invite().name == request.resource.data.name && invite().family == request.resource.data.family;
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /families/{family}/reports/{id} {
      function belongs(role) {
        return request.auth != null && member().family == family && member().role == role;
      }
      allow read: if belongs('parent');
      allow create: if belongs('student')
        && id.matches('[a-f0-9-]{36}')
        && request.resource.data.keys().hasAll(['uid','time','body'])
        && request.resource.data.keys().hasOnly(['uid','time','body'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.time is timestamp
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 12000;
      allow update: if belongs('student') && resource.data.uid == request.auth.uid
        && request.resource.data == resource.data;
    }
  }
}
